# RadioArchive deployment settings. Attached to every release as env.example.
# Save it as .env next to compose.yaml and fill it in. Generate each secret
# with: openssl rand -base64 36 | tr -d '/+='
# See https://github.com/RIKIKU/RadioArchive/blob/main/docs/deploy.md

# Public URLs, behind your own reverse proxy (TLS). Authentik needs its own
# subdomain. AUTHENTIK_URL is also Authentik's own Base URL: scheme and host
# only.
APP_URL=https://radio.example.org
AUTHENTIK_URL=https://auth.example.org

# The first admin (ADR 0025): while no admin exists, the account that signs
# in with this address, proven by its emailed code, becomes one. Ignored once
# an admin exists. Must differ from AUTHENTIK_ADMIN_EMAIL below.
INITIAL_ADMIN_EMAIL=you@example.org
# Listeners may enrol themselves by emailed code (R103): true or false. An
# account only saves their preferences; listening never needs one.
LISTENER_SIGNUP=true

# The deployment's time zone: the nightly run's, the backups', and the one
# times and downloads are shown in.
TZ=Australia/Melbourne
# Local time of the nightly run that deletes recordings past retention.
# NIGHTLY_AT=03:00

# Your reverse proxy's one address, as the API sees it (docs/deploy.md, "The
# reverse proxy"): a request from it counts as the last address in its
# X-Forwarded-For. An exact address, never a range. Unset, every listener
# behind the proxy counts as one client for the heavy-use limits.
# TRUSTED_PROXY=172.18.0.1

# Beside PagerArchive (docs/deploy.md, "Beside PagerArchive"), each on its
# own subdomain of one parent domain. PagerArchive's address turns on the app
# switcher to it, for everyone who can reach the radio; its name there is
# Pager unless PAGERARCHIVE_NAME says otherwise. LOOK_COOKIE_DOMAIN, the
# same as PagerArchive's, shares the look and the colour theme between the
# two; APP_URL's host must be in it. Unset is standalone.
# PAGERARCHIVE_URL=https://pager.example.org
# PAGERARCHIVE_NAME=Pager
# LOOK_COOKIE_DOMAIN=example.org

# Android App Links: lets the RadioArchive Android app open this radio's
# links. The app's package, a colon, and its signing certificate's SHA-256
# fingerprint; more fingerprints follow after a comma or semicolon. Served at
# /.well-known/assetlinks.json, which must be reachable without any sign-in
# gate. Unset answers 404.
# ANDROID_APP_LINKS=io.github.rikiku.radioarchive:15:75:26:74:5E:C7:11:23:68:1E:1D:2C:2A:2D:BF:49:C3:1E:83:4B:C7:8B:0B:BF:95:7D:56:0A:60:FA:A8:CB

# Heavy-use limits (SPEC.md section 6.11). Unset is the default shown.
# LIMIT_REQUESTS=120
# LIMIT_PLAYBACK=600
# LIMIT_LIVE_PER_CLIENT=4
# LIMIT_LIVE_TOTAL=50
# LIMIT_ZIPS_PER_CLIENT=2
# LIMIT_ZIPS_TOTAL=6
# LIMIT_ZIP_SPEED=2
# LIMIT_ZIP_SPEED_TOTAL=8

# The recordings volume (R88): below this much free, the oldest recordings
# are deleted early, but never one from the last RECORDINGS_EARLY_DELETE_FLOOR.
# RECORDINGS_MIN_FREE=5%
# RECORDINGS_EARLY_DELETE_FLOOR=24h
# How long a recorder is disconnected or deaf before listeners see "Some
# talkgroups aren't being received right now" (R15).
# RECORDER_NOTICE_AFTER=2m

# Nightly backups (docs/deploy.md, "Backups"). The folder the dumps go to, a
# path starting with ./ or /; when each night's backup starts, after the
# nightly run; how many nights are kept; and who owns the files, which only
# that user and group can read (they hold the whole setup and the accounts).
# BACKUP_DIR=./backups
# BACKUP_AT=04:00
# BACKUP_KEEP_DAYS=14
# BACKUP_UID=0
# BACKUP_GID=0

# Automatic upgrades (docs/deploy.md, "Automatic upgrades"): off unless you
# run deploy/auto-upgrade/auto-upgrade.sh enable.

# Secrets.
POSTGRES_PASSWORD=
AUTHENTIK_DB_PASSWORD=
AUTHENTIK_SECRET_KEY=
# Bearer token for GET /metrics, which the monitoring stack's Alloy scrapes
# (docs/deploy.md, "Monitoring"). At least 16 characters. Without it, metrics
# are off.
METRICS_TOKEN=
# The radio's Authentik API token and OIDC client secret: any long random
# strings; Authentik is configured with them on start.
AUTHENTIK_API_TOKEN=
OIDC_CLIENT_SECRET=

# Authentik's own administrator account (username akadmin), for you as the
# deployment's operator. Not a RadioArchive account. Must differ from
# INITIAL_ADMIN_EMAIL above. Used when Authentik is first set up: changing it
# here later doesn't change the account.
AUTHENTIK_ADMIN_EMAIL=authentik-admin@example.org
AUTHENTIK_ADMIN_PASSWORD=

# Mail for listeners' sign-up codes, sent by Authentik.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=RadioArchive <radio@example.org>

# Where the containers listen. Keep them on 127.0.0.1 (or a private address)
# and let your reverse proxy reach them.
# API_BIND=127.0.0.1:8080
# AUTHENTIK_BIND=127.0.0.1:9000
