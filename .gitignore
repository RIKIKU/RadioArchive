.claude/
# The browser app's build output (embedded by web/web.go; the folder stays
# so a Go-only build compiles) and dependencies.
web/build/*
!web/build/.gitkeep
web/node_modules/
web/.svelte-kit/
web/test-results/
web/playwright-report/
# The module's behaviour tests' recordings (scripts/ci/e2e-module.sh).
.e2e-module/
# The development and test stack's made-up settings (scripts/dev-env.sh),
# and its backups (compose.yaml's BACKUP_DIR).
.env
/backups/
